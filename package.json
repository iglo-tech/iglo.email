{
  "name": "iglo.email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile ./src/main.ts --outfile ./dist/iglo.email",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "reference:prepare": "bun test/reference/prepare.ts",
    "reference:run": "bun test/reference/run.ts",
    "reference:smoke": "bun test/reference/smoke.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4"
}
